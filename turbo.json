{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["build"]
		},
		"size": {
			"dependsOn": ["build"]
		},
		"publint": {
			"dependsOn": ["build"]
		},
		"attw": {
			"dependsOn": ["build"]
		}
	}
}
