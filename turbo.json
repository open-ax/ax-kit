{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", ".astro/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["build"]
		},
		"test:conformance": {
			"dependsOn": ["build"]
		},
		"size": {
			"dependsOn": ["build"]
		},
		"publint": {
			"dependsOn": ["build"]
		},
		"attw": {
			"dependsOn": ["build"]
		}
	}
}
