---
/**
 * The footer, which is where the site's own honesty lives.
 *
 * Two facts that are easy to omit and expensive to leave out: which draft the
 * documentation describes, and where a vulnerability report goes. A reader
 * assessing this library needs both, and a reader who cannot find either has to
 * ask — which is the outcome a security route and a conformance claim both exist
 * to prevent.
 *
 * ## The layout classes are the framework's, not invented here
 *
 * `sl-flex` comes from the documentation framework's own stylesheet and the rules
 * for it live in a cascade layer it owns. An earlier version of this file used its
 * own class and rendered edge to edge, unstyled, in the wrong typeface — because
 * overriding a component inherits its position but not its styles. Re-declaring
 * them would be a second design system that drifts from the first.
 *
 * ## Explicit spaces
 *
 * `{" "}` at the line joins are not decoration. A newline inside a JSX-like
 * expression collapses to nothing, so prose wrapped across source lines renders
 * as `specificationis linked` — which is exactly what the first version did, and
 * is the kind of small wrongness that makes a site feel unfinished.
 *
 * The last-updated and pagination components the framework's own footer carries
 * are deliberately absent: this site's pages change rarely, so a date would be
 * noise, and the sidebar already carries the navigation.
 */

import { SPEC_VERSION } from "@ax-kit/core";

const year = new Date().getFullYear();
---

<footer class="sl-flex ax-foot">
	<p>
		Documentation for <strong>{SPEC_VERSION.draft}</strong>, upstream{" "}
		<code>{SPEC_VERSION.commit}</code>. The specification is{" "}
		<a href="https://webmachinelearning.github.io/webmcp/">
			linked, not copied
		</a>.
	</p>
	<p>
		<a href="/reference/conformance/">Conformance</a> is zero unexpected failures
		against a pinned draft, measured on three engines.{" "}
		<a href="/security/reporting/">Report a vulnerability privately</a>: please do
		not open a public issue.
	</p>
	<p class="ax-foot__meta">
		Apache-2.0 · <a href="https://github.com/open-ax/ax-kit">Source</a> ·{" "}
		<a href="/llms.json">llms.json</a> · © {year}
	</p>
</footer>

<style>
	@layer starlight.core {
		/*
		 * sl-flex is the framework's own layout utility and it sets a row
		 * direction. Inherited unchanged it put the three paragraphs side by side
		 * in three narrow columns, which is not what a footer is. The direction is
		 * set here rather than by dropping the class, because the framework's own
		 * footer uses sl-flex too and dropping it loses the gap handling that
		 * comes with it.
		 *
		 * Colours are named rather than taken from the framework's grey ramp: that
		 * ramp's numbering is not a lightness ordering, so remapping it produced
		 * pale grey text on a near-white page.
		 */
		.ax-foot {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			margin-top: 28px;
			padding-top: 18px;
			border-top: 1px solid var(--ax-rule);
			font-size: 13px;
			line-height: 1.65;
			color: var(--ax-muted);
			max-width: 46rem;
		}
		.ax-foot p {
			margin: 0;
		}
		.ax-foot strong {
			color: var(--ax-body);
			font-weight: 600;
		}
		.ax-foot a,
		.ax-foot a:visited {
			color: var(--ax-body);
			text-decoration: underline;
			text-decoration-color: var(--ax-rule-strong);
			text-underline-offset: 3px;
		}
		.ax-foot a:hover {
			color: var(--ax-ink);
			text-decoration-color: var(--ax-ink);
		}
		.ax-foot__meta {
			margin-top: 0.25rem;
		}
	}
</style>
