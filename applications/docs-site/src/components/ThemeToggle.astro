---
const SUN = `<svg class="ax-theme-toggle__icon ax-theme-toggle__icon--sun" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Z"></path><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 1v2m0 18v2M4.2 4.2l1.4 1.4m12.8 12.8 1.4 1.4M1 12h2m18 0h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>`;
const MOON = `<svg class="ax-theme-toggle__icon ax-theme-toggle__icon--moon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 6a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>`;
---

<ax-theme-toggle>
	<button type="button" class="ax-theme-toggle__button" aria-live="polite">
		<Fragment set:html={SUN} />
		<Fragment set:html={MOON} />
		<span class="sr-only ax-theme-toggle__label">Switch theme</span>
	</button>
</ax-theme-toggle>

<script>
	type Theme = "light" | "dark";

	const STORAGE_KEY = "starlight-theme";

	function currentTheme(): Theme {
		return document.documentElement.dataset.theme === "light" ? "light" : "dark";
	}

	function nextTheme(): Theme {
		return currentTheme() === "dark" ? "light" : "dark";
	}

	function apply(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem(STORAGE_KEY, theme);
		} catch {
		}
		window.StarlightThemeProvider?.updatePickers(theme);
	}

	function label(theme: Theme): string {
		return theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
	}

	class AxThemeToggle extends HTMLElement {
		#button: HTMLButtonElement | null = null;

		connectedCallback(): void {
			this.#button = this.querySelector("button");
			if (!this.#button) return;
			sync(this.#button);
			this.#button.addEventListener("click", onClick);
		}

		disconnectedCallback(): void {
			this.#button?.removeEventListener("click", onClick);
		}
	}

	function onClick(event: Event): void {
		const button = event.currentTarget;
		if (!(button instanceof HTMLButtonElement)) return;
		apply(nextTheme());
		sync(button);
	}

	function sync(button: HTMLButtonElement): void {
		const theme = currentTheme();
		button.dataset.theme = theme;
		button.setAttribute("aria-label", label(theme));
		const text = button.querySelector(".ax-theme-toggle__label");
		if (text) text.textContent = label(theme);
	}

	if (!customElements.get("ax-theme-toggle")) {
		customElements.define("ax-theme-toggle", AxThemeToggle);
	}

	window
		.matchMedia("(prefers-color-scheme: light)")
		.addEventListener("change", () => {
			let stored: string | null = null;
			try {
				stored = localStorage.getItem(STORAGE_KEY);
			} catch {
			}
			if (stored) return;
			for (const button of document.querySelectorAll(
				"ax-theme-toggle button",
			)) {
				if (button instanceof HTMLButtonElement) sync(button);
			}
		});
</script>