{
	"name": "@ax-kit/extension",
	"version": "0.0.0",
	"description": "Trusted-tier bridge driving document.modelContext from a service worker",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"size": "echo \"no size gate for extension bridge\"",
		"publint": "publint",
		"attw": "attw --pack . --profile node16"
	},
	"devDependencies": {
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.0.2"
	}
}
