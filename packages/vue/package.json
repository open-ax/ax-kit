{
	"name": "@ax-kit/vue",
	"version": "0.0.0",
	"description": "Lifecycle-native ModelContext bindings for Vue",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/open-ax/ax-kit.git",
		"directory": "packages/vue"
	},
	"homepage": "https://github.com/open-ax/ax-kit",
	"bugs": "https://github.com/open-ax/ax-kit/issues",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"peerDependencies": {
		"vue": "^3.4.0"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"size": "echo \"no size gate for bindings\"",
		"publint": "publint --strict",
		"attw": "attw --pack . --profile node16"
	},
	"devDependencies": {
		"@ax-kit/core": "workspace:*",
		"@types/node": "^24.19.0",
		"@vitest/browser-playwright": "5.0.2",
		"happy-dom": "20.14.5",
		"playwright": "1.63.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.0.2",
		"vue": "3.5.43",
		"vue-tsc": "3.3.12"
	}
}
