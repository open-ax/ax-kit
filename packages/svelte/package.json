{
	"name": "@ax-kit/svelte",
	"version": "0.0.0",
	"description": "Lifecycle-native ModelContext bindings for Svelte",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"size": "echo \"no size gate for bindings\"",
		"publint": "publint",
		"attw": "attw --pack . --profile node16"
	},
	"devDependencies": {
		"@ax-kit/core": "workspace:*",
		"@types/node": "^24.19.0",
		"@vitest/browser-playwright": "5.0.2",
		"happy-dom": "20.14.5",
		"playwright": "1.63.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.0.2"
	}
}
