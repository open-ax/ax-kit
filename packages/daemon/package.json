{
	"name": "@ax-kit/daemon",
	"version": "0.1.0",
	"description": "Stateless MCP bridge over stdio with local transport and native host",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/open-ax/ax-kit.git",
		"directory": "packages/daemon"
	},
	"homepage": "https://github.com/open-ax/ax-kit",
	"bugs": "https://github.com/open-ax/ax-kit/issues",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"ax-kit-daemon": "./bin/ax-kit-daemon.mjs",
		"ax-kit-browser-host": "./bin/ax-kit-browser-host.mjs",
		"ax-kit-install-native-host": "./bin/ax-kit-install-native-host.mjs"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:protocol": "vitest run test/protocol-conformance.test.ts",
		"size": "echo \"no size gate for daemon bridge\"",
		"publint": "publint --strict",
		"attw": "attw --pack . --profile node16"
	},
	"devDependencies": {
		"@modelcontextprotocol/conformance": "0.2.0-alpha.12",
		"@types/node": "^24.19.0",
		"playwright": "1.64.1",
		"tsdown": "0.23.1",
		"typescript": "6.0.3",
		"vitest": "5.0.2"
	}
}
