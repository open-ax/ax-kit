{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/pnpm-lock.yaml",
			"!**/.astro",
			"!**/*.astro",
			"!**/*.mdx",
			"!applications/docs-site/src/data/api-report.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			},
			"correctness": {
				"usePlaywrightValidDescribeCallback": "off",
				"noComponentHookFactories": "off"
			},
			"style": {
				"noDescendingSpecificity": "off",
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
